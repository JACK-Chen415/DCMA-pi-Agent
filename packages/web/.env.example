DEEPSEEK_API_KEY=replace-with-your-deepseek-key
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
# Optional: restrict discovery to one database after its actual name is confirmed
# MYSQL_DATABASE=your-industrial-database

# Optional semantic retrieval for the bundled industrial knowledge base.
# The chat model key above is not used for embeddings.
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=replace-with-your-embedding-key
# EMBEDDING_MODEL=BAAI/bge-m3
